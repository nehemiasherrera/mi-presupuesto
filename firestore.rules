rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email() in [
          'nehemiasherreramedina@gmail.com',
          'susanpenaestevez92@gmail.com'
        ];
    }
    function accessDoc() {
      return get(/databases/$(database)/documents/household/access).data;
    }
    function isAllowed() {
      return isOwner() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/household/access)
        && email() in accessDoc().emails
      );
    }
    function guestPerm() {
      return ('permissions' in accessDoc() && email() in accessDoc().permissions)
        ? accessDoc().permissions[email()]
        : { 'views': ['raul'], 'canEdit': false };
    }
    function canViewMain() {
      return isOwner() || (
        isAllowed()
        && ('views' in guestPerm())
        && guestPerm().views.hasAny(['resumen', 'presupuesto', 'gastos', 'prestamos', 'cobros', 'ajustes'])
      );
    }
    function canEditMain() {
      return isOwner() || (
        canViewMain()
        && ('canEdit' in guestPerm())
        && guestPerm().canEdit == true
      );
    }
    function canViewRaul() {
      return isOwner() || (
        isAllowed()
        && ('views' in guestPerm())
        && ('raul' in guestPerm().views)
      );
    }
    function canEditRaul() {
      return isOwner() || (
        canViewRaul()
        && ('canEdit' in guestPerm())
        && guestPerm().canEdit == true
      );
    }
    function isValidMainDoc() {
      return request.resource.data.keys().hasAll(['state', 'updatedBy'])
        && request.resource.data.state is map
        && request.resource.data.state.keys().hasAll(['settings', 'budgets', 'expenses', 'debts'])
        && request.resource.data.state.settings is map
        && request.resource.data.state.budgets is map
        && request.resource.data.state.expenses is list
        && request.resource.data.state.debts is list;
    }
    function isValidRaulDoc() {
      return request.resource.data.keys().hasAll(['raulLoan', 'updatedBy'])
        && request.resource.data.raulLoan is map
        && request.resource.data.raulLoan.payments is list
        && request.resource.data.raulLoan.movements is list;
    }
    function isValidAccessDoc() {
      return request.resource.data.keys().hasAll(['emails'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 25;
    }

    match /household/main {
      allow read: if canViewMain();
      allow create, update: if canEditMain() && isValidMainDoc();
      allow delete: if isOwner();
    }
    match /household/raul_loan {
      allow read: if canViewRaul();
      allow create, update: if canEditRaul() && isValidRaulDoc();
      allow delete: if isOwner();
    }
    match /household/access {
      allow read: if isAllowed();
      allow create, update: if isOwner() && isValidAccessDoc();
      allow delete: if isOwner();
    }
    match /household/activity {
      allow read, write: if isAllowed();
    }
  }
}
