rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email() in [
          'nehemiasherreramedina@gmail.com',
          'susanpenaestevez92@gmail.com'
        ];
    }
    function isAllowed() {
      return isOwner() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/household/access)
        && email() in get(/databases/$(database)/documents/household/access).data.emails
      );
    }

    match /household/main {
      allow read, write: if isAllowed();
    }
    match /household/access {
      allow read: if isAllowed();
      allow write: if isOwner();
    }
  }
}
